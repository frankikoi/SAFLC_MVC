@model dynamic

@{
    string refreshFunction = ViewData["RefreshFunction"]?.ToString() ?? "refreshTable";
}

<div class="d-flex justify-content-between align-items-center mt-3">
    <span class="text-muted small">Page @Model.PageIndex of @Model.TotalPages</span>

    <nav>
        <ul class="pagination pagination-sm mb-0">
            @* Previous Button *@
            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                <button class="page-link" type="button"
                        onclick="@(refreshFunction)(@(Model.PageIndex - 1))">
                    <i class="bi bi-chevron-left"></i>
                </button>
            </li>

            @* Page Numbers *@
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                    <button class="page-link" type="button"
                            onclick="@(refreshFunction)(@i)">
                        @i
                    </button>
                </li>
            }

            @* Next Button *@
            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                <button class="page-link" type="button"
                        onclick="@(refreshFunction)(@(Model.PageIndex + 1))">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </li>
        </ul>
    </nav>
</div>