<div class="modal fade" id="addSubjectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="fw-bold">New Subject</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="createSubjectForm">
                <div class="modal-body p-4">
                    <label class="form-label small fw-bold text-muted">SUBJECT NAME</label>
                    <input type="text" name="SubjectName" id="newSubjectName"
                           class="form-control form-control-lg border-2"
                           placeholder="e.g., Data Structures" required />
                    <div id="validationError" class="text-danger small mt-1 d-none">Please enter a name.</div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="saveSubjectBtn" class="btn btn-dark rounded-pill px-4 shadow-sm">
                        Save Subject
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>